{
  "version": "1.0",
  "note": "ONT read-simulation parameters. Error-type ratios follow published R9.4/Guppy and R10.4/Dorado characteristics: mismatches dominate (>50%), with slightly more deletions than insertions; homopolymer runs double the deletion probability (a known ONT artefact). The total-error profiles are anchors; training samples the total error rate log-uniformly within the range below.",
  "error_type_ratio": {"mismatch": 0.55, "insert": 0.22, "delete": 0.23},
  "profiles": {
    "r10_dorado": {"total": 0.028},
    "r9_sup":     {"total": 0.055},
    "r9_fast":    {"total": 0.085},
    "stressed":   {"total": 0.130}
  },
  "train_total_error_range": [0.015, 0.130],
  "homopolymer_run_min": 4,
  "homopolymer_del_multiplier": 2.5,
  "read_length_lognormal": {"median_bp": 8000, "sigma": 1.0, "min_bp": 150, "max_bp": 60000},
  "segment_len": 1000,
  "min_segment_len": 250,
  "reverse_comp_augmentation": true,
  "seed": 42,
  "test_sets": {
    "t0_val_segments_per_pathogen": 150,
    "t1_seen_segments_per_pathogen": 500,
    "t1_decoy_segments": 2000,
    "t2_unseen_segments_per_pathogen": 500,
    "t3_reads_per_pathogen": 100,
    "t3_decoy_reads": 1000,
    "t4_pond_decoy_reads": 19000,
    "t4_pond_pathogen_reads": 1000,
    "t5_error_grid": [0.02, 0.05, 0.08, 0.11, 0.15],
    "t5_length_grid": [250, 500, 1000, 3000, 10000],
    "t5_reads_per_cell": 30,
    "t6_virus_segments_per_species": 200,
    "t6_virus_decoy_segments": 2000
  }
}
